{
  "compilerOptions": {
    "module": "Node16",
    "target": "ES2022",
    "lib": ["es2022"],
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "rootDir": "src",
    "typeRoots": [
      "../node_modules/@types",
      "../node_modules/@coral-xyz/anchor/types",
      "node_modules/@types",
      "../@types"
    ],
    "moduleResolution": "Node16",
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "useUnknownInCatchVariables": false,
    "strict": true,
    "composite": true
  },
  "references": [
    {
      "path": "../logger"
    },
    {
      "path": "../tx"
    }
  ],
  "compileOnSave": true,
  "include": ["src/**/*"]
}
