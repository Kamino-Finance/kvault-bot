## RPC
RPC_ENDPOINT="${RPC}"
WS_ENDPOINT="${RPC_WS}"
# Optional fallback RPCs. This JSON array is used when USE_RPC_CONFIG_FILE is false.
# RPC_ENDPOINTS='[{"name":"fallback","url":"https://...","dedicatedWriteUrl":"https://..."}]'
# Indexed mode instead uses RPC_READ_1, RPC_SEND_1, and RPC_PRIORITY_FEE_1_TRITON/HELIUS.
# USE_RPC_CONFIG_FILE=true
# optional, for multicast
RPC_MULTICAST_ENDPOINTS='[{"name": "ironforge", "connection": "${IRONFORGE}"}]'
SIMULATE="true"
SPAM="false"
MULTICAST_JITO="false"
PRIORITY_FEE_PERCENTILE=50
PRIORITY_MICRO_LAMPORTS_PER_CU_MIN=1
PRIORITY_MICRO_LAMPORTS_PER_CU_DEFAULT=5000
PRIORITY_MICRO_LAMPORTS_PER_CU_MAX=4000000
RPC_REQUEST_TIMEOUT_MS=120000
EXTERNAL_REQUEST_TIMEOUT_MS=30000
LOOP_HEARTBEAT_TIMEOUT_MS=360000

## Modes of the bot (invest, allocation rebalance)
INVEST_LOOP="true"
ALLOCATION_REBALANCE_LOOP="true"

## WALLET: INVESTOR_SECRET_PATH is the keypair doing the investing which is permisionless so it can be any keypair with some SOL
CLUSTER=mainnet-beta
INVESTOR_SECRET_PATH=../investor.json

## KVAULTS INVEST
# the vaults to be invested (the superset of pubkeys, vaults by owner). If not provided all vaults will be invested
INVEST_VAULTS=6grCt9ChoQEJrR2e118z78PerPjF9GckYHZNnKDMfBKt,A4W6RFQLxNkYceMLJwk8q32HqjteEuE8SK6ejfWv1pnc # vault pubkeys, comma separated
INVEST_OWNERS=sadmBTQm5HJsyzWHEjV4YwG9CiahZKVDVqAyS4Wx1zH # owner pubkeys, comma separated
INVEST_UI_VAULTS="true"

## VAULTS ALLOCATION REBALANCE
# If we do allocation rebalance we need to provide the vaults owners
ALLOCATION_ADMIN_SECRET_PATH=../allocation_admin.json
ALLOCATION_CONFIG_PATH=../allocation_config.json
# Path to the danger-detection blacklist file. 
# When unset outside production it defaults to ./danger_blacklist.json (ephemeral, dev-only).
DANGER_BLACKLIST_PATH=../danger_blacklist.json
# Danger checks freeze the current allocation pass when an off-chain market price is older than this.
MARKET_PRICE_MAX_AGE_SECONDS=300
# GRID_SEARCH_RESOLUTION is the granularity of the allocation in the MAX_YIELD strategy; as the resolution decreases the allocation will be better in terms of yield but it will use (exponentially) more resources' 0.1 means the unit is 10% of AUM, 0.01 means 1%, etc.
# If not set, the default value is 0.01
GRID_SEARCH_RESOLUTION=0.01
# if ALLOCATION_DRY_RUN is true the allocations are computed and printed but the transactions are not sent for ALL vaults; for more granularity you can set it to false and set it per allocation strategy in allocation config json
ALLOCATION_DRY_RUN=true

## KSWAP
# DEFAULT_SWAP_SLIPPAGE_BPS=50
# Independent reference-price tolerance used before signing a swap.
# DEFAULT_PRICE_SLIPPAGE_BPS=150
# KSWAP_API_BASE_URL="https://api.kamino.finance/kswap"
# KSWAP_API_KEY=""

## Looping mode (all optional)
LOOP_INTERVAL_MS=10000
MIN_INVEST_TOKENS=100

## Programs
KLEND_PROGRAM_ID="KLend2g3cP87fffoy8q1mQqGKjrxjC8boSyAYavgmjD"
KVAULTS_PROGRAM_ID="KvauGMspG5k6rtzrqqn7WNn3oZdyKqLKwK2XWQ8FLjd"

NODE_OPTIONS="--max-old-space-size=10000"

## General
SERVER="true"
SERVER_PORT=8080
VERBOSE="false"
