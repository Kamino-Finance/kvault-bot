# Generated by `yarn config:generate` from investing-bot/src/config/settings.ts. Do not edit by hand.
# `yarn config:check` verifies in CI that this file, the README tables and the code agree.
# Copy this file to .env.<PROFILE>. Uncommented lines are a starting profile; commented lines show the defaults.
# Shell-level variables such as NODE_OPTIONS belong in the Dockerfile, the helm chart or the shell, not here.

## RPC
# Legacy mode: the primary RPC URL. Legacy mode needs at least one of RPC_ENDPOINT, RPC_ENDPOINTS or RPC_ENDPOINT_*.
RPC_ENDPOINT="${RPC}"
# WebSocket RPC URL. When unset or blank, the bot derives it from the read RPC URL (https -> wss).
WS_ENDPOINT="${RPC_WS}"
# Legacy mode: fallback RPCs as a JSON array of { url, dedicatedWriteUrl?, name?, feePercentileSupportOverride? } objects.
# RPC_ENDPOINTS=[]
# Legacy mode: one fallback RPC URL per variable, ordered by suffix. A suffix that contains FEES_TRITON_STYLE, FEES_HELIUS_STYLE or FEES_NONE sets the fee API support.
# RPC_ENDPOINT_*=
# Use indexed mode (RPC_READ_<n>, RPC_SEND_<n>, RPC_PRIORITY_FEE_<n>_TRITON/HELIUS) instead of the legacy RPC settings.
# USE_RPC_CONFIG_FILE=false
# Indexed mode: read RPC URLs as RPC_READ_<n>, in numeric fallback order. At least one is required when USE_RPC_CONFIG_FILE=true.
# RPC_READ_*=
# Indexed mode: optional write RPC URL as RPC_SEND_<n>, paired with RPC_READ_<n>.
# RPC_SEND_*=
# Indexed mode: RPC URLs with a priority fee API, as RPC_PRIORITY_FEE_<n>_TRITON or RPC_PRIORITY_FEE_<n>_HELIUS.
# RPC_PRIORITY_FEE_*=
# Extra endpoints that also receive every sent transaction, as a JSON array of { name, connection } objects.
# RPC_MULTICAST_ENDPOINTS=[]
# One multicast endpoint URL per variable, named after the suffix in kebab case (RPC_MULTICAST_ENDPOINT_IRONFORGE -> ironforge).
# RPC_MULTICAST_ENDPOINT_*=
# Timeout in milliseconds for one RPC request. Must be a positive safe integer.
RPC_REQUEST_TIMEOUT_MS=120000
# Timeout in milliseconds for one HTTP request to an external API, such as KSwap or the token flags feed. Must be a positive safe integer.
EXTERNAL_REQUEST_TIMEOUT_MS=30000

## Transactions
# Simulate transactions to find the approximate CU consumed before sending.
SIMULATE=true
# Send the same transaction multiple times.
SPAM=false
# Multicast transactions to Jito validators with a tip instruction.
MULTICAST_JITO=false
# Priority fee percentile: a number in [0, 100], true (the 50th percentile) or false (disabled). Needs an RPC with a percentile fee API.
PRIORITY_FEE_PERCENTILE=50
# Fallback priority fee in micro-lamports per CU. Must be between the MIN and MAX bounds.
PRIORITY_MICRO_LAMPORTS_PER_CU_DEFAULT=5000
# Lower bound of the priority fee in micro-lamports per CU.
PRIORITY_MICRO_LAMPORTS_PER_CU_MIN=1
# Upper bound of the priority fee in micro-lamports per CU.
PRIORITY_MICRO_LAMPORTS_PER_CU_MAX=4000000

## Modes
# Run the invest loop. (default: false)
INVEST_LOOP=true
# Run the allocation-rebalance loop, which includes danger detection, in a worker thread.
ALLOCATION_REBALANCE_LOOP=false

## Wallet
# Keypair file that signs the permissionless invest transactions. Any keypair with some SOL can do this. (default: /run/secrets/investor_keypair)
INVESTOR_SECRET_PATH=../investor.json
# Keypair file of the vaults allocation admin, which signs allocation updates. (default: /run/secrets/allocation_admin)
ALLOCATION_ADMIN_SECRET_PATH=../allocation_admin.json

## Invest
# Vault addresses to invest, separated by commas or whitespace. An address that holds no vault is skipped and logged. With INVEST_VAULTS, INVEST_OWNERS and the UI list all empty, every vault on chain is invested.
# INVEST_VAULTS=
# Vault owner addresses, separated by commas or whitespace. The vaults of these owners are invested too.
# INVEST_OWNERS=
# Also invest the vaults that the Kamino UI lists. (default: false)
INVEST_UI_VAULTS=true
# Vaults exempt from the MIN_SECONDS_SINCE_LAST_INVEST gate, separated by commas or whitespace.
# INVEST_MIN_SLOT_BYPASS_VAULTS=

## Allocation rebalance
# Path to the allocation config JSON file. Set it when the allocation-rebalance loop runs. Separate investing processes must use the same file to enforce enabled utilization caps. The invest loop rereads it before normal invests. (default: empty)
ALLOCATION_CONFIG_PATH=../allocation_config.json
# Allocation granularity of the MAX_YIELD strategy family as a fraction of AUM, in (0, 1]. A lower value finds better yield but uses exponentially more resources.
GRID_SEARCH_RESOLUTION=0.01
# Maximum candidates one MAX_YIELD-family grid search counts for one vault, across all phases. Each generated point and each evaluation counts once, and a point generated in two refinement regions counts twice. When the search reaches it, the vault keeps its current allocation for that pass. A positive integer.
# GRID_SEARCH_MAX_CANDIDATES=5000000
# Maximum wall-clock time in milliseconds of one MAX_YIELD-family grid search for one vault. When the search reaches it, the vault keeps its current allocation for that pass. A positive integer.
# GRID_SEARCH_MAX_MS=300000
# The allocation loop computes and logs allocations but sends no transactions; the invest loop still sends. When false, the allocation config sets dry run per entry or vault. (default: false)
ALLOCATION_DRY_RUN=true

## Danger detection
# Path to the danger-detection blacklist file, on a persistent volume; its directory must exist. The invest loop reads it to skip vaults with a pending evacuation or blacklisted exposure. Outside production an unset value falls back to an ephemeral dev-only file. (default: ./danger_blacklist.json)
DANGER_BLACKLIST_PATH=../danger_blacklist.json
# Age limit in seconds of a KSwap market price. Danger checks freeze the current allocation pass, and the invest loop skips its crank-funding swaps, when a price is older.
MARKET_PRICE_MAX_AGE_SECONDS=300
# Scope price age limit L, in seconds. A zero or near-zero price is as old as the longer of its publish age and the time it has read zero. Safety score: 0.4 past L, 0.2 past 2L and 0 past 4L. A positive integer.
# MAX_STALE_PRICE_DURATION_SECONDS=3600
# Seconds after a transient danger pull-out during which the reserve gets no new funds in any vault: no new weight and no deposit. In memory: a restart clears it. A positive integer.
# REINVEST_COOLDOWN_SECONDS=2700
# Maximum seconds the allocation loop sleeps between two passes, each of which starts with a danger pass. The loop sleeps for the smallest of this and every rebalanceFrequencySeconds; each vault still rebalances at its own frequency. The time a pass takes adds to the gap. A positive integer.
# DANGER_PASS_INTERVAL_SECONDS=300
# Kamino token flags feed that tells which tokens are stablecoins or LSTs.
# KAMINO_TOKEN_FLAGS_URL=https://tokens.kamino.finance/tokens-flags.json

## KSwap
# Base URL of the KSwap API, for swap routes and market prices.
# KSWAP_API_BASE_URL=https://api.kamino.finance/kswap
# Optional KSwap API key, sent as the x-api-key header.
# KSWAP_API_KEY=
# Swap slippage tolerance in basis points, a safe integer in [0, 10000).
# DEFAULT_SWAP_SLIPPAGE_BPS=100
# Independent reference-price tolerance in basis points, checked before signing a swap.
# DEFAULT_PRICE_SLIPPAGE_BPS=150

## Looping
# Sleep in milliseconds between two invest passes. When a vault is invested is set by MIN_SECONDS_SINCE_LAST_INVEST. Must be a positive safe integer. (default: 600000)
LOOP_INTERVAL_MS=10000
# The health server reports not ready when a loop sends no heartbeat for this many milliseconds. Defaults to 3 x RPC_REQUEST_TIMEOUT_MS.
LOOP_HEARTBEAT_TIMEOUT_MS=360000
# A vault is invested only when its move, the larger of its deposits and its withdrawals, exceeds this many tokens. One count for every mint. (default: 10)
MIN_INVEST_TOKENS=100
# Minimum seconds since a vault's last invest before it is invested again; converted to slots at run time.
# MIN_SECONDS_SINCE_LAST_INVEST=1200
# A reserve whose invest or disinvest instruction the programs reject for a vault is dropped from that vault's invests for this many milliseconds. 0 disables the cooldown.
# RESERVE_INVEST_COOLDOWN_MS=600000
# Maximum number of unique reserves loaded in one batch of vault reserves. Must be greater than 0.
# VAULT_RESERVES_MAX_UNIQUE_RESERVES_PER_BATCH=50

## Programs
# Kamino Lend program address.
KLEND_PROGRAM_ID=KLend2g3cP87fffoy8q1mQqGKjrxjC8boSyAYavgmjD
# Kamino Vaults program address.
KVAULTS_PROGRAM_ID=KvauGMspG5k6rtzrqqn7WNn3oZdyKqLKwK2XWQ8FLjd

## General
# Solana cluster. The process environment value also selects the default PROFILE.
CLUSTER=mainnet-beta
# Selects the .env.<PROFILE> file to load, so set it in the shell. Defaults to CLUSTER.
# PROFILE=
# Run the health server, which reports ready while every enabled loop sends heartbeats and the allocation loop's danger passes are not failing.
# SERVER=true
# Health server port, an integer in [1, 65535]. An empty value uses the default.
# SERVER_PORT=8080
# Log the details of each allocation computation.
# VERBOSE=false

## Logging
# Winston log level. The logger package reads it directly.
# LOG_LEVEL=info
